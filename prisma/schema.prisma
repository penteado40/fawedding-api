generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gift {
  id         Int      @id @default(autoincrement())
  name       String
  image      String?
  amazonLink String?
  price      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("gifts")
}
enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum UserRole {
  SUPER_ADMIN
  USER
}

model Wedding {
  id        Int             @id @default(autoincrement())
  name      String
  slug      String          @unique
  date      DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  rsvps     Rsvp[]
  apiTokens ApiToken[]
  managers  WeddingManager[]

  @@map("weddings")
}

model WeddingManager {
  id        Int      @id @default(autoincrement())
  weddingId Int
  userId    Int
  createdAt DateTime @default(now())
  wedding   Wedding  @relation(fields: [weddingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([weddingId, userId])
  @@map("wedding_managers")
}

model Rsvp {
  id        Int        @id @default(autoincrement())
  weddingId Int
  name      String
  email     String
  phone     String
  status    RsvpStatus @default(CONFIRMED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  wedding   Wedding    @relation(fields: [weddingId], references: [id])

  @@unique([weddingId, email])
  @@map("rsvps")
}

model User {
  id             Int              @id @default(autoincrement())
  name           String
  email          String           @unique
  hashedPassword String
  role           UserRole         @default(USER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  managedWeddings WeddingManager[]

  @@map("users")
}

model ApiToken {
  id        Int      @id @default(autoincrement())
  weddingId Int
  name      String   @unique
  token     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wedding   Wedding  @relation(fields: [weddingId], references: [id])

  @@map("api_tokens")
}
